# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Supabase 대시보드 → Project Settings → API 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키
# ※ service_role 키는 절대 넣지 마세요.

# (선택) 생기부 초안 AI — 서버에서만 쓰는 값이라 VITE_ 를 붙이지 않습니다
# Anthropic 콘솔(console.anthropic.com) → API Keys 에서 만든 키
ANTHROPIC_API_KEY=
# (선택) 이 메일 도메인의 교사만 AI 사용 (쉼표로 구분). 비워 두면 가입한 모든 교사
AI_ALLOWED_EMAIL_DOMAINS=
